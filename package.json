{
  "name": "philtv-js",
  "version": "2.4.0",
  "description": "A simple library to pair and interact with Philips TV",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "philtv-js": "./dist/bin/pairing.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./constants": {
      "types": "./dist/constants.d.mts",
      "import": "./dist/constants.mjs",
      "require": "./dist/constants.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "watch": "pnpm build --watch",
    "docs:generate": "typedoc",
    "docs:dev": "pnpm docs:generate && vitepress dev docs",
    "docs:build": "pnpm docs:generate && vitepress build docs",
    "docs:preview": "pnpm docs:generate && vitepress preview docs",
    "format": "pnpm biome format",
    "lint": "pnpm biome lint",
    "lint:check": "pnpm biome check",
    "lint:ci": "pnpm biome ci",
    "release": "pnpm release-it",
    "release:test": "pnpm release-it --dry-run",
    "test": "vitest ."
  },
  "dependencies": {
    "consola": "3.4.2",
    "radash": "12.1.1",
    "urllib": "4.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "26.6.6",
    "@types/validator": "13.15.10",
    "release-it": "21.1.2",
    "tsdown": "^0.23.7",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "ambilight",
    "android-tv",
    "jointspace",
    "philips",
    "philtv"
  ],
  "author": "Clément BERARD <contact@berard.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clement-berard/philtv-js.git"
  },
  "bugs": {
    "url": "https://github.com/clement-berard/philtv-js/issues"
  },
  "homepage": "https://github.com/clement-berard/philtv-js#readme",
  "files": [
    "dist"
  ]
}
